{
    "name": "vip-baccarat-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/vip-baccarat-service.git"
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "test": "jest --testPathPattern=__tests__/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=__tests__/unit-tests/",
        "integration-test": "jest __tests__/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit --testResultsProcessor=jest-junit",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "chance": "^1.1.7",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "sc-game-base": "4.1.0",
        "sc-instrument": "1.1.1"
    },
    "resolutions": {
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "29.0.0",
        "babel-jest": "29.0.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "29.0.0",
        "jest-extended": "4.0.0",
        "jest-junit": "^12.2.0",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-service-integration-utils": "1.3.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
